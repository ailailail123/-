      { id: "gardening", name: "حدائق وتشجير", icon: "🌿", desc: "تقليم، زراعة، وتنظيف حدائق" },
      { id: "daily", name: "عامل يومي عام", icon: "🤝", desc: "مساعدة عامة حسب حاجة الزبون" }
    ];

    let state = {
      role: "customer",
      commissionRate: 10,
      selectedStatus: "الكل",
      activeWorkerId: "w1",
      workers: [
        {
          id: "w1",
          name: "حيدر الشمري",
          phone: "07712345678",
          gov: "بغداد",
