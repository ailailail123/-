          verified: true,
          active: true
        }
      ],
      orders: [
        {
          id: "ORD-101",
          customer: "مصطفى الجبوري",
          phone: "07720001122",
          specialty: "كهربائي",
          gov: "بغداد",
          area: "المنصور",
          time: "2026-11-25T10:00",
          price: 40000,
          paymentMethod: "زين كاش (تحقق صالح)",
          details: "فحص قاطع كهرباء رئيسي وتبديل جوزات",
          status: "بانتظار عامل",
          workerId: null,
          workerName: null,
          customerConfirmed: false,
          workerConfirmed: false,
          settled: false
        }
      ]
    };

    function showToast(msg) {
      const el = document.getElementById("toast");
      el.textContent = msg;
      el.classList.remove("hidden");
      clearTimeout(window.toastTimer);
      window.toastTimer = setTimeout(() => el.classList.add("hidden"), 2800);
    }

    function formatIQD(num) {
      return Number(num || 0).toLocaleString("en-US") + " د.ع";
    }

    function populateSelects() {
      const filterGov = document.getElementById("filterGov");
      const oGov = document.getElementById("oGov");
      const wGov = document.getElementById("wGov");
      const oSpecialty = document.getElementById("oSpecialty");
      const wSpecs = document.getElementById("wSpecialtiesCheckboxes");

      GOVERNORATES.forEach(g => {
        filterGov.innerHTML += `<option value="${g}">${g}</option>`;
        oGov.innerHTML += `<option value="${g}">${g}</option>`;
        wGov.innerHTML += `<option value="${g}">${g}</option>`;
      });

      SPECIALTIES.forEach(s => {
        oSpecialty.innerHTML += `<option value="${s.name}">${s.name}</option>`;
        wSpecs.innerHTML += `
          <label class="flex items-center gap-2 p-2 rounded-xl border border-slate-200 text-xs cursor-pointer hover:bg-teal-50">
            <input type="checkbox" name="workerSpec" value="${s.name}" class="accent-teal-700" />
            <span>${s.icon} ${s.name}</span>
          </label>
        `;
      });
    }

    function switchTab(tab) {
      ["home", "orders", "workers", "wallet", "account", "admin"].forEach(t => {
        document.getElementById(`view-${t}`).classList.toggle("hidden", t !== tab);
      });
      document.querySelectorAll(".tab-btn").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.tab === tab);
      });
      renderAll();
    }

    function switchRole() {
      state.role = state.role === "customer" ? "worker" : "customer";
      document.getElementById("roleBadge").textContent =
        state.role === "customer" ? "حساب: زبون" : "حساب: عامل";
      showToast(state.role === "customer" ? "تم التبديل إلى وضع الزبون" : "تم التبديل إلى وضع العامل");
      renderOrders();
    }

    function renderCategories() {
      const q = document.getElementById("searchSpecialty").value.trim();
      const gov = document.getElementById("filterGov").value;
      const grid = document.getElementById("categoriesGrid");

      const filtered = SPECIALTIES.filter(s => !q || s.name.includes(q) || s.desc.includes(q));
      document.getElementById("catCount").textContent = `${filtered.length} تخصص متاح`;

      grid.innerHTML = filtered.map(s => `
        <div onclick="openOrderModal('${s.name}', '${gov}')"
          class="bg-white p-3.5 rounded-2xl border border-slate-100 hover:border-teal-500 shadow-xs hover:shadow-md transition cursor-pointer flex flex-col justify-between gap-2">
          <div>
            <div class="text-2xl mb-1.5">${s.icon}</div>
            <h4 class="font-extrabold text-sm text-slate-900">${s.name}</h4>
            <p class="text-[11px] text-slate-500 mt-0.5 leading-snug">${s.desc}</p>
          </div>
          <span class="text-[11px] font-bold text-teal-700">اطلب هذا العامل ←</span>
        </div>
      `).join("");
    }

    function openOrderModal(specialtyName = "", govName = "") {
      if (specialtyName) document.getElementById("oSpecialty").value = specialtyName;
      if (govName) document.getElementById("oGov").value = govName;
      document.getElementById("orderModal").classList.remove("hidden");
    }

    function closeOrderModal() {
      document.getElementById("orderModal").classList.add("hidden");
    }

    function submitOrder(e) {
      e.preventDefault();
      const order = {
        id: "ORD-" + Math.floor(100 + Math.random() * 900),
        customer: document.getElementById("oCustomer").value.trim(),
        phone: document.getElementById("oPhone").value.trim(),
        specialty: document.getElementById("oSpecialty").value,
        gov: document.getElementById("oGov").value,
        area: document.getElementById("oArea").value.trim(),
        time: document.getElementById("oTime").value,
        price: Number(document.getElementById("oPrice").value),
        paymentMethod: document.getElementById("oPaymentMethod").value,
        details: document.getElementById("oDetails").value.trim(),
        status: "بانتظار عامل",
        workerId: null,
        workerName: null,
        customerConfirmed: false,
        workerConfirmed: false,
        settled: false
      };

      state.orders.unshift(order);
      closeOrderModal();
      e.target.reset();
      showToast("تم نشر الطلب وتحويلك إلى خانة الطلبات");
      switchTab("orders");
    }

    function acceptOrder(orderId) {
      const worker = state.workers.find(w => w.id === state.activeWorkerId && w.active);
      if (!worker) {
        showToast("يرجى تفعيل حساب عامل أولاً");
        return;
      }
      const order = state.orders.find(o => o.id === orderId);
      if (!order) return;

      if (order.workerId && order.workerId !== worker.id) {
        showToast("عذراً، تم قبول هذا الطلب من عامل آخر");
        return;
      }

      if (!worker.specialties.includes(order.specialty)) {
        showToast("هذا الطلب لا يطابق اختصاصات العامل الحالية");
        return;
      }

      order.workerId = worker.id;
      order.workerName = worker.name;
      order.status = "مقبول";
      showToast(`تم قبول الطلب بواسطة ${worker.name}`);
      renderOrders();
    }

    function startWork(orderId) {
      const order = state.orders.find(o => o.id === orderId);
      if (order && order.status === "مقبول") {
        order.status = "قيد التنفيذ";
        renderOrders();
      }
    }

    function confirmCompletion(orderId, side) {
      const order = state.orders.find(o => o.id === orderId);
      if (!order) return;

      if (side === "customer") order.customerConfirmed = true;
      if (side === "worker") order.workerConfirmed = true;

      if (order.customerConfirmed && order.workerConfirmed) {
        order.status = "مدفوع";
        order.settled = true;
        showToast("تم تأكيد الطرفين وتمت التسوية المالية بنجاح!");
      } else {
        order.status = "بانتظار التأكيد";
        showToast("تم تسجيل تأكيدك، بانتظار تأكيد الطرف الآخر");
      }
      renderAll();
    }

    function cancelOrder(orderId) {
      const order = state.orders.find(o => o.id === orderId);
      if (order && !order.settled) {
        order.status = "ملغي";
        renderAll();
      }
    }

    function openDispute(orderId) {
      const order = state.orders.find(o => o.id === orderId);
      if (order) {
        order.status = "نزاع";
        showToast("تم فتح نزاع وإرساله إلى الإدارة");
        renderAll();
      }
    }

    function renderStatusFilters() {
      const statuses = ["الكل", "بانتظار عامل", "مقبول", "قيد التنفيذ", "بانتظار التأكيد", "مدفوع", "ملغي", "نزاع"];
      const container = document.getElementById("statusFilters");
      container.innerHTML = statuses.map(st => `
        <button onclick="setStatusFilter('${st}')"
          class="px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap cursor-pointer transition ${
            state.selectedStatus === st
              ? "bg-teal-800 text-white"
              : "bg-white text-slate-600 border border-slate-200 hover:bg-slate-50"
          }">
          ${st}
        </button>
      `).join("");
    }

    function setStatusFilter(st) {
      state.selectedStatus = st;
      renderOrders();
    }

    function renderOrders() {
      renderStatusFilters();
      const list = document.getElementById("ordersList");
      const items = state.orders.filter(o => state.selectedStatus === "الكل" || o.status === state.selectedStatus);

      if (!items.length) {
        list.innerHTML = `<div class="bg-white p-8 rounded-2xl text-center text-sm text-slate-500 border border-slate-100">لا توجد طلبات ضمن هذه الحالة حالياً.</div>`;
        return;
      }

      list.innerHTML = items.map(o => `
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-xs space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="text-xs font-extrabold text-teal-800">#${o.id}</span>
              <span class="font-extrabold text-sm sm:text-base text-slate-900 mr-1">${o.specialty}</span>
              <span class="text-xs text-slate-500">• ${o.gov} - ${o.area}</span>
            </div>
            <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-100 text-amber-900">${o.status}</span>
          </div>

          <p class="text-xs sm:text-sm text-slate-600">${o.details}</p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs bg-slate-50 p-3 rounded-xl">
            <div><b>الزبون:</b> ${o.customer} (${o.phone})</div>
            <div><b>الأجر:</b> ${formatIQD(o.price)}</div>
            <div><b>الدفع:</b> ${o.paymentMethod}</div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
            <div>
              <b>العامل المرتبط:</b>
              ${o.workerName ? `<span class="text-teal-700 font-bold">${o.workerName}</span>` : `<span class="text-slate-400">لم يُعيّن بعد</span>`}
              <span class="mx-2 text-slate-300">|</span>
              <span>تأكيد الزبون: ${o.customerConfirmed ? "✅" : "⏳"}</span>
              <span class="mx-1">•</span>
              <span>تأكيد العامل: ${o.workerConfirmed ? "✅" : "⏳"}</span>
            </div>

            <div class="flex flex-wrap gap-2">
              ${!o.workerId && o.status === "بانتظار عامل" ? `
                <button onclick="acceptOrder('${o.id}')" class="bg-teal-700 hover:bg-teal-600 text-white font-bold px-3 py-1.5 rounded-lg cursor-pointer">
                  قبول الطلب
                </button>
              ` : ""}

              ${o.status === "مقبول" ? `
                <button onclick="startWork('${o.id}')" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-3 py-1.5 rounded-lg cursor-pointer">
                  بدء التنفيذ
                </button>
              ` : ""}

              ${["مقبول", "قيد التنفيذ", "بانتظار التأكيد"].includes(o.status) ? `
                <button onclick="confirmCompletion('${o.id}', 'customer')" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3 py-1.5 rounded-lg cursor-pointer">
                  تأكيد الزبون
                </button>
                <button onclick="confirmCompletion('${o.id}', 'worker')" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-3 py-1.5 rounded-lg cursor-pointer">
                  تأكيد العامل
                </button>
                <button onclick="openDispute('${o.id}')" class="bg-rose-100 hover:bg-rose-200 text-rose-800 font-bold px-3 py-1.5 rounded-lg cursor-pointer">
                  نزاع
                </button>
              ` : ""}

              ${!o.settled && o.status !== "ملغي" ? `
                <button onclick="cancelOrder('${o.id}')" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-3 py-1.5 rounded-lg cursor-pointer">
                  إلغاء
                </button>
              ` : ""}
            </div>
          </div>
        </div>
      `).join("");
    }

    function registerWorker(e) {
      e.preventDefault();
      const selectedSpecs = Array.from(document.querySelectorAll('input[name="workerSpec"]:checked')).map(cb => cb.value);
      if (!selectedSpecs.length) {
        showToast("يرجى اختيار اختصاص واحد على الأقل");
        return;
      }

      const newWorker = {
        id: "w" + Date.now(),
        name: document.getElementById("wName").value.trim(),
        phone: document.getElementById("wPhone").value.trim(),
        gov: document.getElementById("wGov").value,
        area: document.getElementById("wArea").value.trim(),
        specialties: selectedSpecs,
        verified: true,
        active: true
      };

      state.workers.unshift(newWorker);
      state.activeWorkerId = newWorker.id;
      e.target.reset();
      showToast("تم تسجيل العامل وإضافته إلى السجل");
      switchTab("workers");
    }

    function toggleWorkerActive(id) {
      const w = state.workers.find(x => x.id === id);
      if (w) {
        w.active = !w.active;
        renderAll();
      }
    }

    function renderWorkers() {
      const list = document.getElementById("workersList");
      list.innerHTML = state.workers.map(w => `
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-xs space-y-2.5">
          <div class="flex items-center justify-between">
            <div>
              <h4 class="font-extrabold text-sm text-slate-900">${w.name} ${w.verified ? '<span class="text-teal-600 text-xs">✔ موثق</span>' : ''}</h4>
              <p class="text-xs text-slate-500">${w.gov} - ${w.area} • ${w.phone}</p>
            </div>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full ${w.active ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
              ${w.active ? "نشط" : "موقوف"}
            </span>
          </div>
          <div class="flex flex-wrap gap-1.5">
            ${w.specialties.map(sp => `<span class="text-[11px] bg-teal-50 text-teal-800 px-2.5 py-1 rounded-lg font-semibold">${sp}</span>`).join("")}
          </div>
          <div class="pt-1 flex items-center justify-between text-xs">
            <button onclick="state.activeWorkerId='${w.id}'; showToast('تم اختيار ${w.name} كعامل نشط للتجربة')" class="text-teal-700 font-bold hover:underline cursor-pointer">
              تعيين كعامل نشط للتجربة
            </button>
            <button onclick="toggleWorkerActive('${w.id}')" class="text-slate-600 font-bold hover:underline cursor-pointer">
              ${w.active ? "إيقاف الحساب" : "تفعيل الحساب"}
            </button>
          </div>
        </div>
      `).join("");
    }

    function renderWalletAndAdmin() {
      const paidOrders = state.orders.filter(o => o.status === "مدفوع");
      const grossPaid = paidOrders.reduce((sum, o) => sum + Number(o.price || 0), 0);
      const commission = Math.round((grossPaid * state.commissionRate) / 100);
      const workerNet = grossPaid - commission;

      document.getElementById("walletWorkerTotal").textContent = formatIQD(workerNet);
      document.getElementById("walletCommissionTotal").textContent = formatIQD(commission);
      document.getElementById("walletPaidCount").textContent = `${paidOrders.length} طلب`;

      document.getElementById("adminSummary").innerHTML = `
        <div class="bg-slate-50 p-3 rounded-xl">
          <div class="text-xs text-slate-500">إجمالي الطلبات</div>
          <div class="text-lg font-extrabold text-slate-900 mt-1">${state.orders.length}</div>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <div class="text-xs text-slate-500">عدد العمال</div>
          <div class="text-lg font-extrabold text-slate-900 mt-1">${state.workers.length}</div>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <div class="text-xs text-slate-500">النزاعات المفتوحة</div>
          <div class="text-lg font-extrabold text-rose-700 mt-1">${state.orders.filter(o => o.status === "نزاع").length}</div>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <div class="text-xs text-slate-500">العمولات المحصلة</div>
          <div class="text-lg font-extrabold text-amber-700 mt-1">${formatIQD(commission)}</div>
        </div>
      `;
    }

    function updateCommissionRate(val) {
      const num = Math.max(0, Math.min(50, Number(val) || 0));
      state.commissionRate = num;
      document.getElementById("commissionRateInput").value = num;
      showToast(`تم تحديث نسبة العمولة إلى ${num}%`);
      renderWalletAndAdmin();
    }

    function renderAll() {
      renderCategories();
      renderOrders();
      renderWorkers();
      renderWalletAndAdmin();
    }

    populateSelects();
    renderAll();
  </script>
</body>
</html>
