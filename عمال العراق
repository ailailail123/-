<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>عمّال العراق 🇮🇶</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Cairo', sans-serif;
      background-color: #f8fafc;
    }
    .tab-btn.active {
      color: #0f766e;
      font-weight: 700;
    }
    .tab-btn.active .tab-icon {
      background-color: #ccfbf1;
      transform: translateY(-2px);
    }
    .tab-icon {
      transition: all 0.2s ease;
    }
  </style>
</head>
<body class="text-slate-800 pb-24">

  <!-- الشريط العلوي -->
  <header class="bg-teal-800 text-white sticky top-0 z-30 shadow-md">
    <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2.5">
        <div class="w-10 h-10 rounded-xl bg-amber-400 text-teal-950 flex items-center justify-center font-extrabold text-lg shadow">
          ع
        </div>
        <div>
          <h1 class="font-extrabold text-base sm:text-lg leading-tight">عمّال العراق 🇮🇶</h1>
          <p class="text-[11px] text-teal-200">منصة طلب العمال والمهنيين الموثقة</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span id="roleBadge" class="text-xs bg-teal-900/90 border border-teal-600 px-2.5 py-1 rounded-full">
          حساب: زبون
        </span>
        <button onclick="switchRole()" class="text-xs bg-amber-400 hover:bg-amber-300 text-teal-950 font-bold px-3 py-1.5 rounded-lg transition cursor-pointer">
          تبديل الدور
        </button>
      </div>
    </div>
  </header>

  <!-- الإشعارات السريعة -->
  <div id="toast" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 hidden bg-slate-900 text-white text-xs sm:text-sm px-4 py-2.5 rounded-xl shadow-xl border border-slate-700"></div>

  <!-- المحتوى الرئيسي -->
  <main class="max-w-4xl mx-auto px-4 pt-4">

    <!-- 1. تبويب الرئيسية -->
    <section id="view-home" class="space-y-5">
      <!-- بطاقة الترحيب ونشر طلب -->
      <div class="bg-gradient-to-l from-teal-900 via-teal-800 to-emerald-800 text-white rounded-2xl p-5 shadow-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <span class="inline-block text-[11px] bg-white/15 px-2.5 py-0.5 rounded-full">الدفع بعد الإنجاز (After Payment) + تأكيد الطرفين</span>
            <h2 class="text-xl sm:text-2xl font-extrabold">تحتاج عامل أو مهني موثوق يمك؟</h2>
            <p class="text-xs sm:text-sm text-teal-100 max-w-xl">
              انشر طلبك وحدد المحافظة والمنطقة والأجر بالدينار العراقي، والعامل المختص يقبله وينفذه بكل أمان.
            </p>
          </div>
          <button onclick="openOrderModal()" class="bg-amber-400 hover:bg-amber-300 text-teal-950 font-extrabold text-sm px-5 py-3 rounded-xl shadow shrink-0 transition cursor-pointer">
            + نشر طلب عمل
          </button>
        </div>
      </div>

      <!-- البحث والفلترة حسب المحافظة -->
      <div class="bg-white p-3.5 rounded-2xl shadow-sm border border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <input id="searchSpecialty" oninput="renderCategories()" type="text" placeholder="ابحث عن اختصاص (منوّم، تنظيف، كهربائي، سباك...)"
          class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-teal-600" />
        <select id="filterGov" onchange="renderCategories()"
          class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-teal-600 bg-white">
          <option value="">كل محافظات العراق (18 محافظة)</option>
        </select>
      </div>

      <!-- التخصصات الأكثر طلباً -->
      <div>
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-extrabold text-base sm:text-lg text-slate-900">التخصصات الأكثر طلباً في العراق</h3>
          <span id="catCount" class="text-xs text-slate-500"></span>
        </div>
        <div id="categoriesGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3"></div>
      </div>
    </section>

    <!-- 2. تبويب الطلبات -->
    <section id="view-orders" class="hidden space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2 bg-white p-3.5 rounded-2xl border border-slate-100 shadow-sm">
        <div>
          <h2 class="font-extrabold text-lg text-slate-900">إدارة الطلبات والأعمال</h2>
          <p class="text-xs text-slate-500">متابعة الحالات وقبول الطلبات وتأكيد الإنجاز المزدوج (الزبون + العامل)</p>
        </div>
        <button onclick="openOrderModal()" class="bg-teal-700 hover:bg-teal-600 text-white text-xs sm:text-sm font-bold px-4 py-2.5 rounded-xl transition cursor-pointer">
          + طلب جديد
        </button>
      </div>

      <!-- فلترة حالة الطلب -->
      <div class="flex gap-2 overflow-x-auto pb-1" id="statusFilters"></div>

      <!-- قائمة الطلبات -->
      <div id="ordersList" class="space-y-3"></div>
    </section>

    <!-- 3. تبويب العمال -->
    <section id="view-workers" class="hidden space-y-4">
      <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="font-extrabold text-lg text-slate-900">سجل العمال والمهنيين</h2>
          <p class="text-xs text-slate-500">كل عامل يمكن أن يمتلك أكثر من اختصاص ويستقبل الطلبات المناسبة له</p>
        </div>
        <button onclick="switchTab('account')" class="bg-amber-400 hover:bg-amber-300 text-teal-950 text-xs sm:text-sm font-bold px-4 py-2.5 rounded-xl transition cursor-pointer">
          تسجيل حساب عامل جديد
        </button>
      </div>
      <div id="workersList" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
    </section>

    <!-- 4. تبويب المحفظة -->
    <section id="view-wallet" class="hidden space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
          <p class="text-xs text-slate-500">مستحقات العمال المحوّلة</p>
          <p id="walletWorkerTotal" class="text-xl font-extrabold text-teal-800 mt-1">0 د.ع</p>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
          <p class="text-xs text-slate-500">عمولة التطبيق المحصلة</p>
          <p id="walletCommissionTotal" class="text-xl font-extrabold text-amber-600 mt-1">0 د.ع</p>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
          <p class="text-xs text-slate-500">الطلبات المدفوعة بالكامل</p>
          <p id="walletPaidCount" class="text-xl font-extrabold text-slate-800 mt-1">0 طلب</p>
        </div>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm space-y-2">
        <h3 class="font-bold text-sm text-slate-900">آلية الدفع وحماية الأموال المعتمدة</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          يتم التحقق من وسيلة الدفع (ماستركارد مصرفي أو زين كاش / آسيا حوالة) عند نشر الطلب دون خصم مسبق.
          بعد إنجاز العمل وتأكيد الطرفين معاً (الزبون + العامل)، تتحول الحالة إلى <b>مدفوع</b> وتُحتسب مستحقات العامل وعمولة المنصة.
        </p>
      </div>
    </section>

    <!-- 5. تبويب الحساب وتسجيل العامل -->
    <section id="view-account" class="hidden space-y-4">
      <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <h2 class="font-extrabold text-lg text-slate-900">تسجيل / تحديث حساب عامل</h2>
          <p class="text-xs text-slate-500">أضف بياناتك واختر أكثر من اختصاص لتظهر في قائمة العمال وتستقبل الطلبات</p>
        </div>

        <form onsubmit="registerWorker(event)" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold mb-1">اسم العامل الكامل</label>
              <input id="wName" required type="text" placeholder="مثال: علي حسين"
                class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-teal-600" />
            </div>
            <div>
              <label class="block text-xs font-bold mb-1">رقم الهاتف</label>
              <input id="wPhone" required type="tel" placeholder="07700000000"
                class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-teal-600" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold mb-1">المحافظة</label>
              <select id="wGov" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 bg-white"></select>
            </div>
            <div>
              <label class="block text-xs font-bold mb-1">المنطقة / الحي</label>
              <input id="wArea" required type="text" placeholder="مثال: الكرادة / وسط المدينة"
                class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-teal-600" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold mb-2">الاختصاصات (يمكن اختيار أكثر من اختصاص)</label>
            <div id="wSpecialtiesCheckboxes" class="grid grid-cols-2 sm:grid-cols-3 gap-2"></div>
          </div>

          <button type="submit" class="w-full sm:w-auto bg-teal-700 hover:bg-teal-600 text-white font-bold text-sm px-6 py-3 rounded-xl transition cursor-pointer">
            حفظ وإضافة العامل إلى السجل
          </button>
        </form>
      </div>
    </section>

    <!-- 6. تبويب الإدارة -->
    <section id="view-admin" class="hidden space-y-4">
      <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
          <div>
            <h2 class="font-extrabold text-lg text-slate-900">لوحة إدارة التطبيق</h2>
            <p class="text-xs text-slate-500">ضبط نسبة العمولة، متابعة الطلبات والنزاعات، وإدارة حسابات العمال</p>
          </div>
          <div class="flex items-center gap-2">
            <label class="text-xs font-bold">نسبة العمولة (%):</label>
            <input id="commissionRateInput" type="number" min="0" max="50" value="10"
              onchange="updateCommissionRate(this.value)"
              class="w-20 px-2.5 py-1.5 text-sm font-bold border border-slate-300 rounded-lg text-center" />
          </div>
        </div>

        <div id="adminSummary" class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center"></div>
      </div>
    </section>

  </main>

  <!-- نافذة نشر طلب جديد -->
  <div id="orderModal" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="bg-teal-800 text-white px-5 py-3.5 flex items-center justify-between">
        <h3 class="font-extrabold text-base">نشر طلب عمل جديد</h3>
        <button onclick="closeOrderModal()" class="text-teal-100 hover:text-white text-xl leading-none cursor-pointer">&times;</button>
      </div>

      <form onsubmit="submitOrder(event)" class="p-5 space-y-3.5 overflow-y-auto text-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold mb-1">اسم الزبون</label>
            <input id="oCustomer" required type="text" placeholder="اسمك الكامل"
              class="w-full px-3 py-2 rounded-xl border border-slate-200" />
          </div>
          <div>
            <label class="block text-xs font-bold mb-1">رقم الهاتف</label>
            <input id="oPhone" required type="tel" placeholder="07800000000"
              class="w-full px-3 py-2 rounded-xl border border-slate-200" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold mb-1">الاختصاص المطلوب</label>
            <select id="oSpecialty" class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-white"></select>
          </div>
          <div>
            <label class="block text-xs font-bold mb-1">المحافظة</label>
            <select id="oGov" class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-white"></select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold mb-1">المنطقة أو الحي</label>
            <input id="oArea" required type="text" placeholder="مثال: الحسين / المنصور"
              class="w-full px-3 py-2 rounded-xl border border-slate-200" />
          </div>
          <div>
            <label class="block text-xs font-bold mb-1">موعد حضور العامل</label>
            <input id="oTime" required type="datetime-local"
              class="w-full px-3 py-2 rounded-xl border border-slate-200" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold mb-1">الأجر المعروض (دينار عراقي)</label>
            <input id="oPrice" required type="number" min="5000" step="1000" value="35000"
              class="w-full px-3 py-2 rounded-xl border border-slate-200" />
          </div>
          <div>
            <label class="block text-xs font-bold mb-1">التحقق من وسيلة الدفع (بعد الإنجاز)</label>
            <select id="oPaymentMethod" class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-white">
              <option value="زين كاش (تحقق صالح)">زين كاش (تحقق صالح)</option>
              <option value="آسيا حوالة (تحقق صالح)">آسيا حوالة (تحقق صالح)</option>
              <option value="ماستركارد مصرفي (تحقق صالح)">ماستركارد مصرفي (تحقق صالح)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold mb-1">تفاصيل العمل المطلوب</label>
          <textarea id="oDetails" rows="2" required placeholder="اشرح طبيعة العمل أو المساعدة المطلوبة..."
            class="w-full px-3 py-2 rounded-xl border border-slate-200"></textarea>
        </div>

        <div class="pt-2 flex items-center justify-end gap-2">
          <button type="button" onclick="closeOrderModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs cursor-pointer">
            إلغاء
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-teal-700 hover:bg-teal-600 text-white font-bold text-xs cursor-pointer">
            تأكيد ونشر الطلب
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- شريط التنقل السفلي المتوازن في منتصف الشاشة -->
  <nav class="fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-lg">
    <div class="max-w-lg mx-auto px-2 py-1.5 flex items-center justify-between text-center">
      <button onclick="switchTab('home')" data-tab="home" class="tab-btn active flex-1 flex flex-col items-center justify-center py-1 text-[11px] text-slate-500 cursor-pointer">
        <span class="tab-icon w-9 h-7 rounded-xl flex items-center justify-center text-base mb-0.5">🏠</span>
        <span>الرئيسية</span>
      </button>

      <button onclick="switchTab('orders')" data-tab="orders" class="tab-btn flex-1 flex flex-col items-center justify-center py-1 text-[11px] text-slate-500 cursor-pointer">
        <span class="tab-icon w-9 h-7 rounded-xl flex items-center justify-center text-base mb-0.5">📋</span>
        <span>الطلبات</span>
      </button>

      <button onclick="switchTab('workers')" data-tab="workers" class="tab-btn flex-1 flex flex-col items-center justify-center py-1 text-[11px] text-slate-500 cursor-pointer">
        <span class="tab-icon w-9 h-7 rounded-xl flex items-center justify-center text-base mb-0.5">👷</span>
        <span>العمال</span>
      </button>

      <button onclick="switchTab('wallet')" data-tab="wallet" class="tab-btn flex-1 flex flex-col items-center justify-center py-1 text-[11px] text-slate-500 cursor-pointer">
        <span class="tab-icon w-9 h-7 rounded-xl flex items-center justify-center text-base mb-0.5">💳</span>
        <span>المحفظة</span>
      </button>

      <button onclick="switchTab('account')" data-tab="account" class="tab-btn flex-1 flex flex-col items-center justify-center py-1 text-[11px] text-slate-500 cursor-pointer">
        <span class="tab-icon w-9 h-7 rounded-xl flex items-center justify-center text-base mb-0.5">👤</span>
        <span>حسابي</span>
      </button>

      <button onclick="switchTab('admin')" data-tab="admin" class="tab-btn flex-1 flex flex-col items-center justify-center py-1 text-[11px] text-slate-500 cursor-pointer">
        <span class="tab-icon w-9 h-7 rounded-xl flex items-center justify-center text-base mb-0.5">⚙️</span>
        <span>الإدارة</span>
      </button>
    </div>
  </nav>

  <script>
    const GOVERNORATES = [
      "بغداد", "البصرة", "نينوى", "أربيل", "النجف", "كربلاء",
      "الأنبار", "ديالى", "ذي قار", "بابل", "صلاح الدين", "واسط",
      "ميسان", "المثنى", "الديوانية", "كركوك", "دهوك", "حلبجة"
    ];

    const SPECIALTIES = [
      { id: "caregiver", name: "منوّم ومرافق مريض", icon: "🩺", desc: "مرافقة وعناية منزلية أو بالمستشفى" },
